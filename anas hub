-- فەرمانا ٣: دۆزینەوەیا ڕێکا ڕاست کاتێ دیوار هەن (Noclip Toggle)
local NoclipBtn = Instance.new("TextButton")
NoclipBtn.Size = UDim2.new(0.9, 0, 0, 40)
NoclipBtn.Position = UDim2.new(0.05, 0, 0.5, 0)
NoclipBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
NoclipBtn.Text = "👻 Toggle Noclip"
NoclipBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
NoclipBtn.Font = Enum.Font.SourceSansBold
NoclipBtn.TextSize = 14
NoclipBtn.Parent = ContentContainer

local NoclipCorner = Instance.new("UICorner")
NoclipCorner.CornerRadius = UDim.new(0, 6)
NoclipCorner.Parent = NoclipBtn

local noclip = false
NoclipBtn.MouseButton1Click:Connect(function()
    noclip = not noclip
    if noclip then NoclipBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0) else NoclipBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45) end
    game:GetService("RunService").Stepped:Connect(function()
        if noclip and game.Players.LocalPlayer.Character then
            for _, v in pairs(game.Players.LocalPlayer.Character:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = false end
            end
        end
    end)
end)

