local UserHWID = game:GetService("RbxAnalyticsService"):GetClientId()

-- [[ 🔑 لیستا کلیلێن فەرمی یێن تە دڤێت بفرۆشی ]] --
local ValidKeys = {
    ["ANAS_VIP_999"] = true,
    ["KEY_BUYER_02"] = true,
    ["ANAS_GOLD_77"] = true
}

-- [[ 🛡️ سیستەمێ جێگیر یێ پاراستنا مۆبایلێ (HWID Storage Fix) ]] --
local function CheckDeviceLock(EnteredKey)
    if not ValidKeys[EnteredKey] then
        return false, "ERROR: Invalid Key! (کلیل خەلەتە)"
    end

    local fileName = "AnasHub_Lock_" .. EnteredKey .. ".txt"
    
    -- ئەگەر ئەڤ کلیلە بەری نوکە ل سەر مۆبایلەکێ هاتبیتە خەزنکرن
    if isfile(fileName) then
        local savedHWID = readfile(fileName)
        if savedHWID == UserHWID then
            return true
        else
            return false, "ERROR: This key is locked to another device! (ئەڤ کلیلە ل سەر مۆبایلەکا دی یا قفلکرییە)"
        end
    else
        -- ئەگەر جارا ئێکێ بیت کڕیار کلیلێ بکاربینیت، ئێکسەر مۆبایلا وی قفل بکە ب ڤێ کلیلێ ڤە!
        writefile(fileName, UserHWID)
        return true
    end
end

