   Name = "✨🔮 ANAS HUB V11 - KEYBOARD ESCAPE 🔮✨",
   LoadingTitle = "🔥 AUTO WIN ENGINE ACTIVATED 🔥",
   LoadingSubtitle = "👑 Created by Anas 👑",
   Theme = "Ocean",
   DisableRayfieldPrompts = false,
   DisableBuildWarnings = false,
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "AnasHubConfig",
      FileName = "NitroAutoWin"
   }
})

-----------------------------------------------------------
-- [ 🏆 بەشێ نوو: خۆکار سەرکەفتن - NITRO AUTO WIN ] --
-----------------------------------------------------------
local AutoWinTab = Window:CreateTab("🏆 NITRO AUTO WIN", 4483345998)

-- فەرمانا کلیلکرنێ بۆ تێلەپۆرت بوونا ڕاستەوخۆ بۆ ستەیجێ ١٢
AutoWinTab:CreateButton({
   Name = "✨ ┃ INSTANT TELEPORT TO STAGE 12",
   Interact = '🔮 WARP 🔮',
   Callback = function()
        local player = game.Players.LocalPlayer
        -- دۆزینەوەیا پارتێ ستەیجێ ١٢ د ناڤ ماپێ یاریێ دا
        local stage12 = workspace:FindFirstChild("12") or workspace:FindFirstChild("Stage12") or workspace.Stages:FindFirstChild("12")
        
        if stage12 and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            player.Character.HumanoidRootPart.CFrame = stage12.CFrame + Vector3.new(0, 3, 0)
            Rayfield:Notify({
               Title = "ANAS HUB",
               Content = "Successfully Teleported to Stage 12! 👑",
               Duration = 3,
               Image = 4483345998,
            })
        else
            -- ئەگەر ناڤێ پارتێ ١٢ جیاواز بوو، سیستەم دێ ب ڕێکا گەڕیانێ دۆزیتەوە
            local found = false
            for _, v in pairs(workspace:GetDescendants()) do
                if v.Name == "12" and v:IsA("BasePart") then
                    player.Character.HumanoidRootPart.CFrame = v.CFrame + Vector3.new(0, 3, 0)
                    found = true
                    break
                end
            end
            if not found then
                Rayfield:Notify({Title = "ANAS HUB", Content = "Stage 12 part not found, try moving closer!", Duration = 3})
            end
        end
   end,
})

-- فەرمانا ئۆتۆماتیک سەرکەفتن د ناڤبەرا ستەیجان دا (Loop)
local autowinning = false
AutoWinTab:CreateToggle({
   Name = "🔥 ┃ AUTO WIN LOOP (STAGES 1 TO 12)",
   CurrentValue = false,
   Flag = "AutoWinLoopFlag",
   Callback = function(Value)
        autowinning = Value
        task.spawn(function()
            while autowinning do
                local player = game.Players.LocalPlayer
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    -- سیستەم دێ ژ ستەیجێ ١ دەستپێکەت هەتا ١٢
                    for i = 1, 12 do
                        if not autowinning then break end
                        
                        local targetStage = workspace:FindFirstChild(tostring(i)) or workspace.Stages:FindFirstChild(tostring(i))
                        if targetStage and targetStage:IsA("BasePart") then
                            player.Character.HumanoidRootPart.CFrame = targetStage.CFrame + Vector3.new(0, 3, 0)
                            task.wait(0.5) -- دەمێ چەرمەسەریێ د ناڤبەرا ستەیجان دا دا یاری کراش نەکەت
                        else
                            -- گەڕیانا گشتی ئەگەر د فۆڵدەرەکێ دی دا بن
                            for _, v in pairs(workspace:GetDescendants()) do
                                if v.Name == tostring(i) and v:IsA("BasePart") then
                                    player.Character.HumanoidRootPart.CFrame = v.CFrame + Vector3.new(0, 3, 0)
                                    task.wait(0.5)
                                    break
                                end
                            end
                        end
                    end
                end
                task.wait(1)
            end
        end)
   end,
})

