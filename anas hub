        if player.Character then
            -- ئەگەر پێشتر هێلایت هەبیت لایدەبەین بۆ نوێکردنەوە
            if player.Character:FindFirstChild("AnasHubESP") then
                player.Character.AnasHubESP:Destroy()
            end
            
            local Highlight = Instance.new("Highlight")
            Highlight.Name = "AnasHubESP"
            Highlight.FillColor = Color3.fromRGB(255, 0, 100)
            Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            Highlight.FillTransparency = 0.4
            Highlight.OutlineTransparency = 0
            Highlight.Adornee = player.Character
