-- [ 💥 VIOLENCE DISTRICT: SMART GREEN/RED ESP LOGIC ] --
local SmartEspActive = false

local function IsHoldingKnife(player)
    if not player.Character then return false end
    -- پشکنین کا ئەرێ کێر د دەست دایە یان د باکپاکێ دایە
    if player.Character:FindFirstChild("Knife") or player.Character:FindFirstChildOfClass("Tool") or (player:FindFirstChild("Backpack") and player.Backpack:FindFirstChild("Knife")) then
        return true
    end
    return false
end

local function ApplySmartESP(player)
    if player == game.Players.LocalPlayer then return end
    
    task.spawn(function()
        while SmartEspActive and player.Character and task.wait(1) do
            pcall(function()
                if player.Character then
                    local highlight = player.Character:FindFirstChild("AnasHubSmartESP")
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "AnasHubSmartESP"
                        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                        highlight.OutlineTransparency = 0
                        highlight.Adornee = player.Character
                        highlight.Parent = player.Character
                    end
                    
                    -- گۆڕینا ڕەنگی ل سەر بنەمایێ هەبوونا کێرێ
                    if IsHoldingKnife(player) then
                        highlight.FillColor = Color3.fromRGB(255, 0, 0) -- سۆر بۆ ئەوان کۆ کێر هەیە
                        highlight.FillTransparency = 0.3
                    else
                        highlight.FillColor = Color3.fromRGB(0, 255, 100) -- کەسک بۆ یاریزانێن عادی
                        highlight.FillTransparency = 0.5
                    end
                end
            end)
        end
    end)
end

