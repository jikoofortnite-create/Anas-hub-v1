-- [[ 📊 داتابەیسا کلیلان و مۆبایلان - HWID DATABASE ]] --
-- تێبینی: کاتێ کڕیارێ نوو سکرێپتێ دکڕیت، تو HWID یا وی دگۆڕی ل جهێ "EMPTY_HWID"
local KeyDatabase = {
    ["ANAS_VIP_999"] = "EMPTY_HWID", -- کلیل یا ئامادەیە بۆ کڕیارێ ئێکێ
    ["KEY_BUYER_02"] = "EMPTY_HWID", -- کلیل بۆ کڕیارێ دووێ
    ["ANAS_GOLD_77"] = "EMPTY_HWID"  -- کلیل بۆ کڕیارێ سێیێ
}

-- [[ سیستەمێ پشکنینا کلیلێ و مۆبایلێ ]] --
local KeyValidated = false
local function VerifyKeyAndDevice(EnteredKey)
    -- پشکنین کا کلیل د داتابەیسی دا هەیە یان نە
    if KeyDatabase[EnteredKey] then
        -- ئەگەر کلیل یا نوو بیت و چو مۆبایل پێ ڤە نەهاتبیتە گرێدان:
        if KeyDatabase[EnteredKey] == "EMPTY_HWID" then
            KeyDatabase[EnteredKey] = UserHWID -- ئێکسەر کلیل ب ڤێ مۆبایلێ ڤە گرێدە!
            KeyValidated = true
            return true
        -- ئەگەر کلیل بەری نوکە هاتبیتە گرێدان، پشکنین بکە کا ئەڤە هەمان مۆبایلە یان نە:
        elseif KeyDatabase[EnteredKey] == UserHWID then
            KeyValidated = true
            return true
        else
            -- ئەگەر کلیل د مۆبایلەکا دی دا هاتبیتە بکارئینان:
            return false, "ERROR: This key is already locked to another device!"
        end
    else
        return false, "ERROR: Invalid Key!"
    end
end

