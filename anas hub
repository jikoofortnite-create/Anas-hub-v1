-- [ 🏆 NITRO AUTO WIN ] --
-----------------------------------------------------------
local AutoWinTab = Window:CreateTab("🏆 NITRO AUTO WIN", 4483345998)

AutoWinTab:CreateButton({
   Name = "✨ Teleport to Stage 12",
   Callback = function()
        local player = game.Players.LocalPlayer
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local found = false
            for _, v in pairs(workspace:GetDescendants()) do
                if (v.Name == "12" or v.Name == "Stage12" or v.Name == "Stage 12") and v:IsA("BasePart") then
                    player.Character.HumanoidRootPart.CFrame = v.CFrame + Vector3.new(0, 3, 0)
                    found = true
                    break
                end
            end
            if found then
                Rayfield:Notify({Title = "ANAS HUB", Content = "Warped to Stage 12! 👑", Duration = 3})
            else
                Rayfield:Notify({Title = "ANAS HUB", Content = "Stage 12 not found! Move closer.", Duration = 3})
            end
        end
   end,
})

local autowinning = false
AutoWinTab:CreateToggle({
   Name = "🔥 Auto Win Loop (Stages 1 to 12)",
   CurrentValue = false,
   Flag = "AutoWinHwidFlag",
   Callback = function(Value)
        autowinning = Value
        task.spawn(function()
            while autowinning do
                local player = game.Players.LocalPlayer
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    for i = 1, 12 do
                        if not autowinning then break end
                        for _, v in pairs(workspace:GetDescendants()) do
                            if v.Name == tostring(i) and v:IsA("BasePart") then
                                player.Character.HumanoidRootPart.CFrame = v.CFrame + Vector3.new(0, 3, 0)
                                task.wait(0.4)
                                break
                            end
                        end
                    end
                end
                task.wait(1)
            end
        end)
   end,
})

