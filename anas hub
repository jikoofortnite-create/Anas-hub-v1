local function CreateTab(name, pos)
    local Btn = Instance.new("TextButton", TabButtons)
    Btn.Size = UDim2.new(1, -10, 0, 40)
    Btn.Position = UDim2.new(0, 5, 0, pos)
    Btn.Text = name
