-- [[ 🏆 TARGET AUTO WIN SYSTEM (UP TO STAGE 14) ]] --
local IsAutoWinning = false
AutoWinBtn.MouseButton1Click:Connect(function()
    if IsAutoWinning then return end
    IsAutoWinning = true
    AutoWinBtn.Text = "⚡ GOING TO STAGE 14..."
    AutoWinBtn.BackgroundColor3 = Color3.fromRGB(255, 165, 0)
    
    task.spawn(function()
        local player = game.Players.LocalPlayer
        
        -- لۆپ تەنێ هەتا ژمارە ١٤ دچیت
        for stageNumber = 1, 14 do
            if not IsAutoWinning then break end
            
            local character = player.Character or player.CharacterAdded:Wait()
            local hrp = character:WaitForChild("HumanoidRootPart", 5)
            if not hrp then break end
            
            local targetPart = nil
            
            -- پشکنین بۆ دۆزینەوەیا قۆناغێ
            for _, object in pairs(workspace:GetDescendants()) do
                if object:IsA("BasePart") and (object.Name == tostring(stageNumber) or object.Name == "Stage" .. stageNumber or object.Name == "Checkpoint" .. stageNumber) then
                    targetPart = object
                    break
                end
            end
            
            if targetPart then
                -- تیلیپۆرت کرنا نەرم
                hrp.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
                task.wait(0.8) -- کاتەکێ باشتر بۆ کەمکرنا لاگی ل سەر مۆبایلێ
            else
                -- ئەگەر ل ستەیجێ ٥ گیر بوو، بازدەدەتە سەر ستەیجێ داهاتی
                if stageNumber == 5 then
                    task.wait(0.5)
                    continue
                end
            end
        end
        
        -- کاتێ گەهشتە ستەیجێ ١٤، لۆپ خەلاس دبیت و سەرکەفتن دیار دبیت
        AutoWinBtn.Text = "🏁 REACHED STAGE 14"
        AutoWinBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 150)
        IsAutoWinning = false
    end)
end)

