local IsTweening, LegitKillActive, SmartEspActive = false, false, false
local TweenService = game:GetService("TweenService")

KeyboardBtn.MouseButton1Click:Connect(function()
    IsTweening = not IsTweening
    task.spawn(function()
        while IsTweening do task.wait(0.1)
            local hrp = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then TweenService:Create(hrp, TweenInfo.new(0.8, Enum.EasingStyle.Linear), {CFrame = hrp.CFrame * CFrame.new(0, 0, -120)}):Play() end
        end
    end)
end)

KillAuraBtn.MouseButton1Click:Connect(function()
    LegitKillActive = not LegitKillActive
    task.spawn(function()
        while LegitKillActive do task.wait(0.3)
            local myChar = game.Players.LocalPlayer.Character
            local knife = myChar and (myChar:FindFirstChild("Knife") or myChar:FindFirstChildOfClass("Tool"))
            if myChar and knife then
                local closest = nil local dist = 350
                for _, p in pairs(game.Players:GetPlayers()) do
                    if p ~= game.Players.LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        local d = (p.Character.HumanoidRootPart.Position - myChar.HumanoidRootPart.Position).Magnitude
                        if d < dist then dist = d closest = p.Character end
                    end
                end
                if closest then myChar.Humanoid:MoveTo(closest.HumanoidRootPart.Position) if dist < 12 then knife:Activate() end end
            end
        end
    end)
end)

