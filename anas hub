-- [[ سیستەمێ گرێدانا فەرمانێن JavaScript دگەل Lua ]] --
local function handleJsEvent(command)
    local player = game.Players.LocalPlayer
    local char = player.Character
    if not char or not char:FindFirstChild("Humanoid") then return end

    if command == "SPEED" then
        char.Humanoid.WalkSpeed = 60
    elseif command == "JUMP" then
        char.Humanoid.JumpPower = 120
        char.Humanoid.UseJumpPower = true
    elseif command == "CLOSE" then
        ScreenGui:Destroy()
    end
end

-- ئەڤ فەرمانا ل خوارێ (Bridge) د جیهانا ڕاستەقینە دا پەیوەندیێ د دەتە کارلێکرنا JS
-- بۆ نموونە کاتێ یاریزان کلیکێ ل دوگمەکا HTML دکەت:
MainFrame.MouseEnter:Connect(function()
    -- ل ڤێرە لایەنێ Lua هەمیشە یێ بەرهەڤە بۆ وەرگرتنا فەرمانێن ژ لایێ JavaScript دهێن
    local fakeJsBridge = "SPEED" -- نموونەیەکا جێبەجێکرنێ
    handleJsEvent(fakeJsBridge)
end)
