            while autowinning do
                local player = game.Players.LocalPlayer
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    -- سیستەم دێ ژ ستەیجێ ١ دەستپێکەت هەتا ١٢
                    for i = 1, 12 do
                        if not autowinning then break end
                        
                        local targetStage = workspace:FindFirstChild(tostring(i)) or workspace.Stages:FindFirstChild(tostring(i))
